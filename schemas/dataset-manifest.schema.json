{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/space-exploration-101/yolo-gray1-data-pipeline/schemas/dataset-manifest.schema.json",
  "title": "Grayprep smoke selection manifest",
  "type": "object",
  "required": ["schema_version", "manifest_type", "dataset_id", "source_dataset_yaml", "source_dataset_yaml_sha256", "source_semantics", "seed", "per_class_per_split", "class_names", "item_count", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_type": {"const": "grayprep-smoke-selection"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_dataset_yaml": {"type": "string", "minLength": 1},
    "source_dataset_yaml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_semantics": {"const": "r_only"},
    "seed": {"type": "integer"},
    "per_class_per_split": {"type": "integer", "minimum": 1},
    "class_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "item_count": {"type": "integer", "minimum": 1},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class_id", "class_name", "source_split", "split", "source_image", "source_label"],
        "properties": {
          "class_id": {"type": "integer", "minimum": 0},
          "class_name": {"type": "string", "minLength": 1},
          "source_split": {"enum": ["train", "val", "test"]},
          "split": {"enum": ["train", "val", "test", "calibration"]},
          "source_image": {"type": "string", "minLength": 1},
          "source_label": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
