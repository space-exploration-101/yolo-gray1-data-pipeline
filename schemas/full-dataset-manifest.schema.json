{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/space-exploration-101/yolo-gray1-data-pipeline/schemas/full-dataset-manifest.schema.json",
  "title": "Grayprep full source dataset index",
  "type": "object",
  "required": [
    "schema_version", "manifest_type", "dataset_id", "source_dataset_yaml",
    "source_dataset_yaml_sha256", "source_semantics", "class_names", "kpt_shape",
    "split_counts", "item_count", "source_revision", "items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_type": {"const": "grayprep-full-index"},
    "dataset_id": {"type": "string", "minLength": 1},
    "source_dataset_yaml": {"type": "string", "minLength": 1},
    "source_dataset_yaml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_semantics": {"const": "r_only"},
    "class_names": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "kpt_shape": {"const": [2, 3]},
    "split_counts": {"type": "object"},
    "item_count": {"type": "integer", "minimum": 1},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "split", "group_id", "source_image", "source_label",
          "source_image_size", "source_image_mtime_ns", "source_label_size",
          "source_label_mtime_ns", "source_label_sha256", "is_empty",
          "row_count", "class_ids"
        ],
        "properties": {
          "split": {"enum": ["train", "val", "test"]},
          "group_id": {"type": "string", "minLength": 1},
          "source_image": {"type": "string", "minLength": 1},
          "source_label": {"type": "string", "minLength": 1},
          "source_image_size": {"type": "integer", "minimum": 1},
          "source_image_mtime_ns": {"type": "integer", "minimum": 0},
          "source_label_size": {"type": "integer", "minimum": 0},
          "source_label_mtime_ns": {"type": "integer", "minimum": 0},
          "source_label_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "is_empty": {"type": "boolean"},
          "row_count": {"type": "integer", "minimum": 0},
          "class_ids": {
            "type": "array", "items": {"type": "integer", "minimum": 0}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
